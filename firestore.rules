rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Acro Party: anyone who opened the app (signed in anonymously) can play.
    match /games/{code}/{document=**} {
      allow read, write: if request.auth != null;
    }
    // Letter Rip challenge games
    match /letterRip/{code}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
